# dependencies
node_modules/

# build output
dist/
src-tauri/target/
src-tauri/gen/
# kraken-engine is built standalone (not a workspace member — see
# src-tauri/Cargo.toml), so it has its own target/ dir.
src-tauri/kraken-engine/target/
# ppocr-engine is also standalone (same out-of-workspace trick).
src-tauri/ppocr-engine/target/

# misc
.DS_Store
*.log

# Debug scratch: analysis scripts and dumped pipeline images
# (KRKN_DUMP_DIR output, A/B comparisons, etc.)
debug/

# Kraken models are now tracked via Git LFS (see .gitattributes) so they're
# available to CI. Keep sample scans out of the repo.
sample_pdf/
sample_images/
.superpowers/

# ZCode agent session plans (local scratch)
.zcode/plans/
